{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rush-ui",
  "version": "0.1.0",
  "identifier": "dev.rushwind.rush-ui",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RushWind Toolkit",
        "width": 1024,
        "height": 768,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}