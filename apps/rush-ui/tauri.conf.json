{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rush-ui",
  "version": "0.1.0",
  "identifier": "dev.rushwind.rush-ui",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RushWind 工具箱",
